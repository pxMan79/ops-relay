# ============================================
# ops-relay 环境变量模板
# 复制此文件为 .env 并填入真实值
# ⚠️ 绝对不要将 .env 提交到 Git！
# ============================================

# ==================== API 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# CORS 允许的来源（生产环境必须限制）
CORS_ORIGINS=http://localhost:5173,http://your-domain.com

# ==================== 数据库配置 ====================
DB_PATH=/app/data/monitoring.db
DATA_RETENTION_DAYS=30

# ==================== 钉钉机器人配置（敏感！） ====================
# ⚠️ 请在钉钉群机器人设置中获取这些值
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN_HERE
DINGTALK_SECRET=YOUR_SIGNING_SECRET_HERE
DINGTALK_MENTION_ALL=false
DINGTALK_MENTION_MOBILES=

# ==================== 数据采集配置 ====================
COLLECTION_CRON=0 8 * * *
COLLECTION_TIMEOUT=60
COLLECTION_RETRY_COUNT=2
ANSIBLE_INVENTORY_PATH=./inventory.ini

# ==================== 安全配置（生产环境必填） ====================
# JWT Secret（用于 API 认证，随机字符串）
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS

# API Token（简单认证方式）
API_TOKEN=CHANGE_ME_TO_SECURE_TOKEN

# ==================== 服务器监控目标 ====================
# 注意：真实 IP 列表请放在 config.yml 中
# 此处仅存储加密密钥等

# ==================== 日志级别 ====================
LOG_LEVEL=INFO
