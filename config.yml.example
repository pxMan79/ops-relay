# ============================================
# ops-relay 配置文件模板（已脱敏）
# ⚠️ 这是示例配置，不要直接用于生产！
# 部署时请复制为 config.yml 并修改真实值
# ============================================

# 服务器分组配置
servers:
  groups:
    all_linux:
      - 10.0.0.168
      - 10.0.0.199
      # 添加更多服务器 IP...
    windows: []

  # 优先级排序（数字越小越靠前显示）
  priority_list:
    - ip: 10.0.0.168
      priority: 1
    - ip: 10.0.0.199
      priority: 2

# 告警阈值配置
alert_thresholds:
  memory:
    warning: 80      # 80% 显示橙色警告
    critical: 90     # 90% 显示红色严重告警
  disk:
    warning: 85
    critical: 95
  cpu:
    warning: 85
    critical: 95

# 钉钉通知配置（⚠️ 敏感信息 - 已脱敏）
dingtalk:
  enabled: false  # 测试阶段建议关闭
  webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=REPLACE_WITH_YOUR_TOKEN"
  secret: "REPLACE_WITH_YOUR_SIGNING_SECRET"  # 可选：加签密钥
  mention_all: false  # 是否 @所有人
  mention_mobiles: []  # @指定手机号

# 数据采集配置
collection:
  cron_expression: "0 8 * * *"  # Cron 表达式（每天早上8点执行）
  timeout_seconds: 60  # 单台服务器采集超时时间（秒）
  retry_count: 2  # 失败后重试次数

# API 服务配置
api:
  host: "0.0.0.0"
  port: 8000
  debug: false  # 生产环境务必关闭 debug
  cors_origins:
    - "http://localhost:5173"  # 开发环境前端地址
    # - "http://your-production-domain.com"  # 生产环境取消注释

# 数据库配置
database:
  path: "./data/monitoring.db"  # SQLite 数据库路径
  retention_days: 30  # 历史数据保留天数（超过自动清理）

# Excel 报表配置
excel:
  output_dir: "/root/ops_monitor/reports/"
  filename_pattern: "Server_Report_{date}.xlsx"
  auto_generate: true  # 是否每次采集后自动生成 Excel
